# ================================
# GVC EXPERTOS - Variables de Entorno
# ================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Autenticación Admin
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Admin inicial (opcional, para script create-admin)
ADMIN_EMAIL=admin@gvcexpertos.es
ADMIN_PASSWORD=your-secure-password

# Email SMTP OVH (formulario de contacto). Misma receta que Tricholand.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contacto@gvcabogados.com
SMTP_PASS=
SMTP_FROM=GVC Expertos <contacto@gvcabogados.com>
SMTP_TO=contacto@gvcabogados.com

# ISR Revalidación
REVALIDATE_SECRET=your-revalidation-secret

# Entorno
NEXT_PUBLIC_SITE_URL=https://gvcexpertos.es
NODE_ENV=development

# Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-D23DZMB7SG
NEXT_PUBLIC_GA_ID=G-D23DZMB7SG
